# Copy this file to .env. The .env file is local and ignored by Git.
# Paths are relative to maintenance/ when used by the provided scripts.
export TARA_MAINTENANCE_CONFIG="config/maintenance.json"

# Optional: override the auto-detected .venv Python interpreter.
# export PYTHON="/absolute/path/to/python"

# Optional model credentials belong only in .env or Pi's external auth store.
# Never put real API keys in tracked JSON, Markdown, or .env.example.
# export ANTHROPIC_API_KEY="replace-me-locally"
