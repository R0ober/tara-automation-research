{
  "$schema": "https://tarav.local/schema/item-definition/1.1.0",
  "item_definition": {
    "item_id": "ITEM-MIN",
    "name": "L017 negative: every drawn edge fully stated (key table, explicit protection, encrypted entry point)"
  },
  "components": [
    {
      "component_id": "COMP-A",
      "name": "A",
      "trust_zone": "Zone_1",
      "interfaces": [
        "INT-BUS",
        "INT-OBD"
      ]
    },
    {
      "component_id": "COMP-B",
      "name": "B",
      "trust_zone": "Zone_2",
      "interfaces": [
        "INT-BUS"
      ],
      "security_configuration": {
        "secoc_mac_enabled": false,
        "e2e_crc_enabled": false
      }
    }
  ],
  "connections": [
