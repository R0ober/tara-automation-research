      "messages": [
        {
          "can_id": "0x10",
          "name": "same endpoints, folded"
        }
      ]
    },
    {
      "connection_id": "CONN-ENTRY",
      "source_component": "EXTERNAL_TESTER",
      "target_component": "COMP-A",
      "encrypted": false,
      "entry_points": [
        {
          "interface_id": "INT-OBD",
          "encrypted": true
        }
      ]
    }
  ],
  "assets": [
    {
      "asset_id": "ASSET-1",
      "name": "a",
      "parent_component": "COMP-B",
      "damage_scenarios": [
        {
          "damage_id": "DS-1"
        }
      ]
    }
  ]
